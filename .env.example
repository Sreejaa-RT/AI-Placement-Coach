# ==========================================
# AI Placement Coach - Environment Variables
# ==========================================

# 1. Express / Node.js Backend (Render)
PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Python FastAPI ML Backend (Render)
# (PORT is set automatically by Render on deployment)

# 3. React / Vite Frontend (Vercel)
# In Vercel Project Settings -> Environment Variables, add the deployed Render URLs:
VITE_ML_API_URL=https://your-ml-service.onrender.com
VITE_NODE_API_URL=https://your-node-service.onrender.com
